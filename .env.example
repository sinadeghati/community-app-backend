# Local development defaults (copy to .env and adjust as needed).
# Production uses Railway environment variables — do not commit secrets.

# Django
DEBUG=1

# Local uploaded files (/media/) — keep enabled unless using object storage.
SERVE_MEDIA=1

# Email (optional for local dev; console backend is the default)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# DEFAULT_FROM_EMAIL=Korook <noreply@korook.com>

# Frontend URLs (local / staging examples)
# FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
# FRONTEND_EMAIL_VERIFICATION_URL=https://korook.com/verify-email

# Production examples (set on Railway production only — not staging values):
# DEBUG=0
# FRONTEND_PASSWORD_RESET_URL=https://www.korook.com/reset-password
# DEFAULT_FROM_EMAIL=Korook <noreply@korook.com>
